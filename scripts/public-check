#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-only
"""Deterministic public-repository hygiene check (no network, no model call).

Modes (any combination; default is --tree :index):
  --tree REV            (repeatable) files of REV (":index" = staged tree): text, file names, licence baseline
  --history SPEC        every commit of `git rev-list SPEC`: messages, author fields, file names
                        and file versions it introduced, and baseline shrinking
  --commit-msg FILE     a commit message file (comment lines ignored)
  --text FILE           any text (PR or issue title/body, tag message)
  --licence-update      record new licence lines in the baseline (never removes one)

Exit status: 0 clean, 1 findings, 2 usage or configuration error. The forbidden patterns are in
scripts/public-check.patterns and the reasoned exceptions in scripts/public-check.allow, so this
file holds no forbidden word. Words that must never be written into the repository at all (a phone serial, a
private name) go in a local file of the same pattern format outside the tree: .git/info/public-check-extra or --extra FILE.
"""
import argparse
import bisect
import fnmatch
import os
import re
import shlex
import subprocess
import sys
from collections import Counter

HERE = os.path.dirname(os.path.abspath(__file__))
MAX_TEXT_BYTES = 16 * 1024 * 1024
BASELINE_HEADER = (
    '# Recorded licence, copyright, SPDX and "modified" lines. Format: <count><TAB><normalised line>\n'
    "# Written by: scripts/public-check --licence-update (adds only). A removed or changed line fails the check.\n"
)
LICENCE_LINE = re.compile(r"^.*(?:copyright|spdx-license-identifier|licen[cs]e|©|\bmodified\b).*$", re.I | re.M)
LICENCE_HINT = re.compile(r"copyright|spdx-license-identifier|licen[cs]e|©|modified")
LICENCE_NORMAL = re.compile(r"copyright|spdx-license-identifier|licen[cs]e|©|^modified(?: by\b.*)?$", re.I)
SCISSORS = "# ------------------------ >8 ------------------------"


class ConfigError(Exception):
    pass


class Pattern:
    def __init__(self, cls, scope, hints, source, lineno, what="patterns"):
        try:
            self.rx = re.compile(source, re.I | re.M)
        except re.error as exc:
            raise ConfigError("%s line %d: bad regex: %s" % (what, lineno, exc))
        self.hints = []
        if hints != "-":
            self.hints = [h.replace("~", "").replace("_", " ") for h in hints.split(",")]
            if not all(h and h == h.casefold() for h in self.hints):
                raise ConfigError("%s line %d: hints must be non-empty lowercase literals" % (what, lineno))
        self.cls = cls
        self.scope = scope
        self.source = source


def load_patterns(path, what="patterns", allow_empty=False):
    patterns = []
    try:
        fh = open(path, encoding="utf-8")
    except OSError as exc:
        raise ConfigError("cannot read %s: %s" % (what, exc))
    with fh:
        for lineno, raw in enumerate(fh, 1):
            line = raw.rstrip("\n")
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            parts = line.split(None, 3)
            if len(parts) != 4 or parts[1] not in ("all", "msg"):
                raise ConfigError("%s line %d: expected '<class> <all|msg> <hints> <regex>'" % (what, lineno))
            patterns.append(Pattern(parts[0], parts[1], parts[2], parts[3], lineno, what))
    if not patterns and not allow_empty:
        raise ConfigError("patterns file is empty")
    return patterns


def load_extra_patterns(path):
    """Patterns kept outside the tree (default: the git directory), for words that must not be written into the repository.
    No file means no extra patterns; a file that exists but cannot be read or parsed is an error, never a pass."""
    if path is None:
        out = run_git(["rev-parse", "--path-format=absolute", "--git-path", "info/public-check-extra"], check=False)
        path = out.decode("utf-8", "replace").strip()
        if not path:
            return []
    if not os.path.lexists(path):
        return []
    return load_patterns(path, "public-check-extra", allow_empty=True)


class Allow:
    def __init__(self):
        self.text = []
        self.licence_ignore = []
        self.licence_waive = []

    def permits(self, cls, path, matched):
        for a_cls, glob, rx in self.text:
            if a_cls in ("*", cls) and fnmatch.fnmatchcase(path, glob) and rx.search(matched):
                return True
        return False

    def licence_ignored(self, path):
        return any(fnmatch.fnmatchcase(path, glob) for glob in self.licence_ignore)

    def licence_waived(self, line):
        return any(rx.search(line) for rx in self.licence_waive)


def load_allow(path):
    allow = Allow()
    try:
        fh = open(path, encoding="utf-8")
    except OSError as exc:
        raise ConfigError("cannot read allow-list: %s" % exc)
    with fh:
        for lineno, raw in enumerate(fh, 1):
            line = raw.rstrip("\n")
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            parts = line.split("\t")
            kind = parts[0]
            complete = all(p.strip() for p in parts[1:])
            try:
                if kind == "allow" and len(parts) == 5 and complete:
                    allow.text.append((parts[1], parts[2], re.compile(parts[3], re.I)))
                elif kind == "licence-ignore" and len(parts) == 3 and complete:
                    allow.licence_ignore.append(parts[1])
                elif kind == "licence-waive" and len(parts) == 3 and complete:
                    allow.licence_waive.append(re.compile(parts[1], re.I))
                else:
                    raise ConfigError("allow-list line %d: malformed entry or missing reason" % lineno)
            except re.error as exc:
                raise ConfigError("allow-list line %d: bad regex: %s" % (lineno, exc))
    return allow


def scan_text(text, patterns):
    """Return (line, class, matched text) for every pattern hit, before the allow-list."""
    folded = text.casefold()
    offsets = None
    found = []
    for p in patterns:
        if p.hints and not any(h in folded for h in p.hints):
            continue
        for m in p.rx.finditer(text):
            if offsets is None:
                offsets = [n.start() for n in re.finditer("\n", text)]
            found.append((bisect.bisect_right(offsets, m.start()) + 1, p.cls, m.group(0)))
    found.sort(key=lambda f: (f[0], f[1]))
    return found


def snippet(matched):
    one = " ".join(matched.split())
    return one if len(one) <= 60 else one[:57] + "..."


def normalise_licence_line(line):
    return " ".join(line.strip(" \t\r/*#<!->").split())


def licence_lines(text):
    found = Counter()
    lower = text.lower()
    if len(lower) == len(text):
        spans = []
        end = -1
        for m in LICENCE_HINT.finditer(lower):
            if m.start() < end:
                continue
            start = text.rfind("\n", 0, m.start()) + 1
            end = text.find("\n", m.end())
            end = len(text) if end < 0 else end
            spans.append(text[start:end])
    else:
        spans = [m.group(0) for m in LICENCE_LINE.finditer(text)]
    for span in spans:
        line = normalise_licence_line(span)
        if line and LICENCE_NORMAL.search(line):
            found[line] += 1
    return found


def parse_baseline(text, where):
    recorded = {}
    for lineno, raw in enumerate(text.splitlines(), 1):
        if not raw.strip() or raw.startswith("#"):
            continue
        count, sep, line = raw.partition("\t")
        if not sep or not count.isdigit() or not line:
            raise ConfigError("%s line %d: expected '<count><TAB><line>'" % (where, lineno))
        recorded[line] = (int(count), lineno)
    return recorded


def load_baseline(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return parse_baseline(fh.read(), os.path.basename(path))
    except OSError as exc:
        raise ConfigError("cannot read licence baseline: %s" % exc)


def run_git(args, check=True):
    proc = subprocess.run(["git", *args], capture_output=True)
    if check and proc.returncode != 0:
        raise ConfigError("git %s failed: %s" % (" ".join(args[:2]), proc.stderr.decode("utf-8", "replace").strip()))
    return proc.stdout


class BlobReader:
    def __init__(self):
        self.proc = subprocess.Popen(["git", "cat-file", "--batch"], stdin=subprocess.PIPE, stdout=subprocess.PIPE)

    def read(self, sha):
        self.proc.stdin.write(sha.encode() + b"\n")
        self.proc.stdin.flush()
        header = self.proc.stdout.readline().split()
        if len(header) != 3:
            raise ConfigError("object %s not readable" % sha)
        data = self.proc.stdout.read(int(header[2]))
        self.proc.stdout.read(1)
        return data

    def close(self):
        self.proc.stdin.close()
        self.proc.wait()


def tree_blobs(rev):
    """Yield (path, blob sha) for a revision, or for the index when rev is ':index'."""
    if rev == ":index":
        out = run_git(["ls-files", "-s", "-z"])
    else:
        out = run_git(["ls-tree", "-r", "-z", rev])
    for entry in out.split(b"\0"):
        if not entry:
            continue
        meta, path = entry.split(b"\t", 1)
        fields = meta.split()
        if rev == ":index":
            mode, sha = fields[0], fields[1]
            is_blob = mode != b"160000"
        else:
            is_blob = fields[1] == b"blob"
            sha = fields[2]
        if is_blob:
            yield path.decode("utf-8", "replace"), sha.decode()


def is_binary(data):
    return b"\0" in data[:8192]


class Checker:
    def __init__(self, patterns, allow, baseline_path):
        self.patterns = patterns
        self.allow = allow
        self.baseline_path = baseline_path
        self.file_patterns = [p for p in patterns if p.scope == "all"]
        self.findings = []
        self.seen = set()

    def add(self, location, cls, matched, shorten=True):
        self.findings.append("%s: [%s] %s" % (location, cls, snippet(matched) if shorten else matched))

    def report(self, label, hits, prefix="", dedupe=False):
        for line, cls, matched in hits:
            if self.allow.permits(cls, label, matched):
                continue
            if dedupe:
                key = (label, cls, matched)
                if key in self.seen:
                    continue
                self.seen.add(key)
            self.add("%s%s:%d" % (prefix, label, line), cls, matched)

    def check_name(self, path, prefix="", dedupe=False):
        hits = [(0, cls + "/file-name", m) for _l, cls, m in scan_text(path, self.file_patterns)]
        for line, cls, matched in hits:
            base_cls = cls.split("/")[0]
            if self.allow.permits(base_cls, path, matched):
                continue
            if dedupe:
                key = (path, cls, matched)
                if key in self.seen:
                    continue
                self.seen.add(key)
            self.add("%s%s:0" % (prefix, path), cls, matched)

    def read_text(self, reader, sha):
        """Return the decoded text, or None for binary content; flag oversize files."""
        data = reader.read(sha)
        if is_binary(data):
            return None, False
        if len(data) > MAX_TEXT_BYTES:
            return None, True
        return data.decode("utf-8", "replace"), False

    def scan_tree(self, rev, prefix=""):
        found_licence = Counter()
        reader = BlobReader()
        try:
            for path, sha in tree_blobs(rev):
                self.check_name(path, prefix)
                text, oversize = self.read_text(reader, sha)
                if oversize:
                    self.add("%s%s:0" % (prefix, path), "unscanned", "file larger than %d bytes" % MAX_TEXT_BYTES)
                if text is None:
                    continue
                self.report(path, scan_text(text, self.file_patterns), prefix)
                if not self.allow.licence_ignored(path):
                    found_licence.update(licence_lines(text))
        finally:
            reader.close()
        return found_licence

    def check_licences(self, found, baseline, prefix=""):
        for line, (recorded, lineno) in sorted(baseline.items(), key=lambda kv: kv[1][1]):
            have = found.get(line, 0)
            if have < recorded and not self.allow.licence_waived(line):
                self.add("%s%s:%d" % (prefix, self.baseline_label(), lineno), "licence",
                         "line removed or changed (recorded %d, found %d): %s" % (recorded, have, line), False)

    def baseline_label(self):
        rel = os.path.relpath(self.baseline_path)
        return os.path.basename(rel) if rel.startswith("..") else rel

    def scan_message(self, label, text, prefix="", dedupe=False):
        self.report(label, scan_text(text, self.patterns), prefix, dedupe)

    def scan_history(self, spec, baseline_repo_path):
        commits = run_git(["rev-list", "--reverse", *shlex.split(spec)]).decode().split()
        reader = BlobReader()
        scanned = {}
        try:
            for commit in commits:
                short = commit[:7] + ":"
                meta = run_git(["log", "-1", "--encoding=UTF-8", "--format=%an <%ae>%x00%cn <%ce>%x00%B", commit])
                author, committer, message = meta.decode("utf-8", "replace").split("\0", 2)
                self.scan_message("author", author, short)
                if committer != author:
                    self.scan_message("committer", committer, short)
                self.scan_message("message", message.rstrip("\n") + "\n", short, dedupe=False)
                raw = run_git(["diff-tree", "-r", "-z", "--root", "--no-renames", "-m", "--no-commit-id", "--raw", commit])
                tokens = raw.split(b"\0")
                i = 0
                while i + 1 < len(tokens):
                    meta_fields = tokens[i].split()
                    path = tokens[i + 1].decode("utf-8", "replace")
                    i += 2
                    if len(meta_fields) < 5:
                        continue
                    old_sha, new_sha, status = meta_fields[2].decode(), meta_fields[3].decode(), meta_fields[4]
                    if status == b"D" or set(new_sha) == {"0"}:
                        if path == baseline_repo_path and status == b"D":
                            self.check_baseline_shrink(short, path, reader, old_sha, None)
                        continue
                    self.check_name(path, short, dedupe=True)
                    if new_sha not in scanned:
                        text, oversize = self.read_text(reader, new_sha)
                        scanned[new_sha] = (
                            [] if text is None else scan_text(text, self.file_patterns), oversize)
                    hits, oversize = scanned[new_sha]
                    if oversize:
                        self.add("%s%s:0" % (short, path), "unscanned", "file larger than %d bytes" % MAX_TEXT_BYTES)
                    self.report(path, hits, short, dedupe=True)
                    if path == baseline_repo_path:
                        self.check_baseline_shrink(short, path, reader, old_sha, new_sha)
        finally:
            reader.close()

    def check_baseline_shrink(self, short, path, reader, old_sha, new_sha):
        if set(old_sha) == {"0"}:
            return
        old = parse_baseline(reader.read(old_sha).decode("utf-8", "replace"), path)
        new = {} if new_sha is None else parse_baseline(reader.read(new_sha).decode("utf-8", "replace"), path)
        for line, (count, lineno) in old.items():
            if new.get(line, (0, 0))[0] < count:
                self.add("%s%s:%d" % (short, path, lineno), "licence-baseline",
                         "recorded line removed or lowered (was %d, now %d): %s" % (count, new.get(line, (0, 0))[0], line), False)


def strip_commit_comments(text):
    lines = text.split("\n")
    out = []
    cut = False
    for line in lines:
        if cut or line.startswith("#"):
            if line.startswith(SCISSORS):
                cut = True
            out.append("")
        else:
            out.append(line)
    return "\n".join(out)


def read_file(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError as exc:
        raise ConfigError("cannot read %s: %s" % (path, exc))


def toplevel_relative(path):
    top = run_git(["rev-parse", "--show-toplevel"], check=False).decode().strip()
    if not top:
        return None
    top = os.path.realpath(top)
    real = os.path.realpath(path)
    return os.path.relpath(real, top) if real.startswith(top + os.sep) else None


def licence_update(checker, baseline_path):
    found = checker.scan_tree(":index")
    recorded = {}
    if os.path.exists(baseline_path):
        recorded = load_baseline(baseline_path)
    dropped = [line for line, (count, _n) in recorded.items()
               if found.get(line, 0) < count and not checker.allow.licence_waived(line)]
    if dropped:
        for line in sorted(dropped):
            print("licence line removed or changed (recorded %d, found %d): %s" % (recorded[line][0], found.get(line, 0), line))
        print("public-check: baseline not updated; restore the lines or add a reasoned waiver", file=sys.stderr)
        return 1
    merged = {line: max(found.get(line, 0), recorded.get(line, (0, 0))[0]) for line in set(found) | set(recorded)}
    body = "".join("%d\t%s\n" % (merged[line], line) for line in sorted(merged))
    with open(baseline_path, "w", encoding="utf-8") as fh:
        fh.write(BASELINE_HEADER + body)
    print("public-check: baseline has %d distinct lines" % len(merged))
    return 0


def main(argv):
    ap = argparse.ArgumentParser(description="Check a repository for public-release hygiene.")
    ap.add_argument("--tree", metavar="REV", action="append", default=[],
                    help="scan the files of REV (':index' = staged tree); repeatable")
    ap.add_argument("--history", metavar="SPEC", help="scan commits of 'git rev-list SPEC'")
    ap.add_argument("--commit-msg", metavar="FILE", action="append", default=[])
    ap.add_argument("--text", metavar="FILE", action="append", default=[])
    ap.add_argument("--licence-update", action="store_true")
    ap.add_argument("--patterns", default=os.path.join(HERE, "public-check.patterns"))
    ap.add_argument("--extra", metavar="FILE",
                    help="more patterns, same format (default: info/public-check-extra in the git directory, if it exists)")
    ap.add_argument("--allow", default=os.path.join(HERE, "public-check.allow"))
    ap.add_argument("--baseline", default=os.path.join(HERE, "public-check.licences"))
    ap.add_argument("--baseline-repo-path", metavar="PATH",
                    help="path of the baseline inside the repository (default: derived from --baseline)")
    args = ap.parse_args(argv)
    try:
        patterns = load_patterns(args.patterns) + load_extra_patterns(args.extra)
        checker = Checker(patterns, load_allow(args.allow), args.baseline)
        if args.licence_update:
            return licence_update(checker, args.baseline)
        trees = args.tree
        if not (trees or args.history or args.commit_msg or args.text):
            trees = [":index"]
        for path in args.commit_msg:
            checker.scan_message(path, strip_commit_comments(read_file(path)))
        for path in args.text:
            checker.scan_message(path, read_file(path))
        if args.history:
            checker.scan_history(args.history, args.baseline_repo_path or toplevel_relative(args.baseline))
        if trees:
            baseline = load_baseline(args.baseline)
            for rev in trees:
                prefix = "%s:" % rev if len(trees) > 1 else ""
                checker.check_licences(checker.scan_tree(rev, prefix), baseline, prefix)
    except ConfigError as exc:
        print("public-check: error: %s" % exc, file=sys.stderr)
        return 2
    for finding in checker.findings:
        print(finding)
    if checker.findings:
        print("public-check: %d finding(s). Fix them, or add a reasoned entry to scripts/public-check.allow." % len(checker.findings),
              file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
