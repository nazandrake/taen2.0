#!/bin/sh
# Blocks a push when the pushed tip tree or any commit in the pushed range (messages, author fields,
# file names and file versions) has public-release findings (scripts/public-check).
top=$(git rev-parse --show-toplevel) || exit 1
cd "$top" || exit 1
command -v python3 >/dev/null 2>&1 || { echo "pre-push: python3 is required for scripts/public-check" >&2; exit 1; }
remote=$1
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac
    tip=$(git rev-parse --verify --quiet "$local_sha^{commit}") || continue
    spec="$tip --not --remotes=$remote"
    case "$remote_sha" in
        *[!0]*) git cat-file -e "$remote_sha^{commit}" 2>/dev/null && spec="$remote_sha..$tip" ;;
    esac
    python3 -I scripts/public-check --tree "$tip" --history "$spec" || status=1
    if [ "$status" -eq 0 ] && [ -x tools/pre-push-checks.sh ]; then
        tools/pre-push-checks.sh "$spec" "$tip" || status=1
    fi
done
exit $status
